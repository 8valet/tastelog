# Copy to .env.local. Use your own project and accounts; no real credentials ship.
NEXT_PUBLIC_LIBRARY_NAME="Tastelog"
NEXT_PUBLIC_LIBRARY_DESCRIPTION="What I watch. What I play. What stays with me."
# Absolute app origin. Set to your HTTPS origin before building for production.
SITE_URL=http://localhost:3000

# Required for saving and owner login. Use a publishable key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# UUID of the Auth user also inserted into public.library_owners.
LIBRARY_OWNER_ID=

# Optional catalog search. Manual entry needs no catalog keys.
TMDB_READ_TOKEN=
MAL_CLIENT_ID=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional Trakt review/import. Requires a deployed HTTPS callback.
TRAKT_CLIENT_ID=
# https://your-domain.example/api/library/trakt/callback
TRAKT_REDIRECT_URI=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable. Changing it makes stored Trakt credentials unreadable.
TRAKT_ENCRYPTION_KEY=
